[init]
	defaultBranch = main
[fetch]
	prune = true
[core]
	editor = nvim
	pager = delta
	excludesFile = ~/.gitignore_global
[alias]
	lg = log --pretty=format:'%C(bold red)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(yellow)%ad%Creset %C(bold blue)<%an>%Creset' --abbrev-commit --date=human --decorate=full
	cleanup = !git reset --hard && git clean -df
	stashl = stash list --oneline
	stashm = !git stash push --include-untracked -m
	stasha = stash apply
	stashp = stash pop
	stashc = stash clear
	restorea = restore ./
	st = status -s --branch
	aa = add -A
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
    side-by-side = true
    syntax-theme = Dracula
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
